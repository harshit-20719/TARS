# --- TARS environment ---
# The mock-first front end needs none of these to run. They document the
# backend contract Mehul fills in later (plan U3 / U5).

# Database (Prisma). SQLite for local dev, Postgres when hosted (spec D9).
DATABASE_URL="file:./dev.db"

# Anthropic API key for the extraction step (plan U5). Not used by the mock.
ANTHROPIC_API_KEY=""

# Extraction model (plan KTD4 / spec D6). Default is the safe tier; Sonnet 5
# is the recommended high-volume optimization — a one-line flip.
EXTRACTION_MODEL="claude-opus-4-8"
# EXTRACTION_MODEL="claude-sonnet-5"
