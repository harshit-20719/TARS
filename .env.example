# --- TARS environment ---
#
# Copy to .env for local development. Every value below is required for the
# deployed app to work, except where marked optional.
#
# Local setup start to finish, and the Vercel provisioning steps, are in
# docs/runbooks/deploy-vercel.md.

# --- Database (required) -----------------------------------------------------
# Postgres. SQLite is not an option on Vercel — serverless filesystems are
# ephemeral, so writes would be silently discarded between requests.
DATABASE_URL="postgresql://tars:tars@127.0.0.1:5433/tars?schema=public"

# A separate database for the test suite. The suite refuses to run unless the
# name contains "_test", so a stray run cannot wipe development data.
TEST_DATABASE_URL="postgresql://tars:tars@127.0.0.1:5433/tars_test?schema=public"

# --- Auth (required) ---------------------------------------------------------
# Session signing secret. Generate one with: npx auth secret
AUTH_SECRET=""

# Google SSO, restricted to the @biome.in domain (see lib/auth.config.ts).
#
# REQUIRED IN PRODUCTION. Auth fails closed: with no provider configured nobody
# can sign in and the deployment is unreachable. That is deliberate for an app
# holding founder call transcripts, but it does mean these two are not optional.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Local-only email + password sign-in, so a checkout with no OAuth credentials
# is still usable. Ignored when NODE_ENV=production, so setting it on Vercel by
# accident cannot open a password door. Seeded users share the password
# "tars-dev" (see prisma/seed.ts).
AUTH_DEV_CREDENTIALS="true"

# --- Extraction (required for the extraction step) ---------------------------
ANTHROPIC_API_KEY=""

# Optional. Defaults to claude-opus-5. Sonnet 5 is the documented swap for
# high-volume drafting (spec D6) — one line, no code change.
# EXTRACTION_MODEL="claude-sonnet-5"
