// TARS — L1 (Conviction) deal record.
//
// These models mirror the record interfaces in mock/types.ts one-for-one. The
// repository (lib/repo) is the only place allowed to see Prisma types; every
// function there returns the plain record interfaces, so the locked front end
// never learns that a database exists.
//
// Framework content — rubrics, sub-dimensions, anchors, pillars, tracks, the
// verification cap — is NOT in here. It is static typed config under /framework
// and is referenced by key (subDimensionKey, slideKey). Scores carry a
// rubricVersion stamp so a later rubric edit stays traceable (spec D2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

/// Which layer of the framework a fact was recorded at. L1 is Conviction.
enum Layer {
  L1
  L2
  L3
  IC
}

/// A sub-dimension is scored either 1..5 (with an "NE" sentinel) or pass/fail.
enum ScoreType {
  scale
  binary
}

enum ObservationStatus {
  draft
  accepted
  edited
  rejected
}

/// How sure the machine is that a quote belongs to the row it filed it under.
///
/// This is the machine rating its own *mapping*, never the founder. "Does this
/// quote belong to this row" is a filing question; "is this founder strong" is a
/// judgment, and the PM still authors every one of those (spec R5). The
/// distinction is what lets a high-confidence mapping file itself: the PM's
/// attention is spent on the score, not on re-checking clerical work.
enum MappingConfidence {
  high
  low
}

/// How one macro-dimension block fared in one extraction run (KTD16, R22).
/// Hyphenated on the wire to match the record type, like OriginTag and Lens.
enum ExtractionOutcome {
  READ             @map("read")
  FAILED_RETRYABLE @map("failed-retryable")
  FAILED_TERMINAL  @map("failed-terminal")
}

/// Where a claim came from. Hyphenated on the wire to match the record type.
enum OriginTag {
  founderVolunteered              @map("founder-volunteered")
  founderConfirmedAfterPmFraming  @map("founder-confirmed-after-PM-framing")
  machineInferred                 @map("machine-inferred")
}

/// At L1 the ledger opens at "claimed" only; validated/refuted are L2.
enum ClaimStatus {
  claimed
  validated
  refuted
}

/// How a slide reads its rooted sub-dimensions.
enum Lens {
  peak
  weakestLink @map("weakest-link")
}

/// PM and PARTNER both author the record, on the same terms — the role says who
/// someone is, not what they may do. ADMIN also manages users. No role is
/// read-only.
enum Role {
  PM
  PARTNER
  ADMIN
}

// ---------------------------------------------------------------- record

model Deal {
  id       String   @id
  company  String
  oneLiner String
  founders String
  /// Display name of the owning PM, kept because the record contract is a string.
  ownerPm  String
  opened   DateTime
  layer    Layer    @default(L1)

  ownerId String?
  owner   User?   @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  calls           Call[]
  observations    Observation[]
  claims          Claim[]
  scores          SubDimensionScore[]
  slides          Slide[]
  founderTypeRead FounderTypeRead?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Call {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  number     Int
  label      String
  date       DateTime
  transcript String
  /// Set once the extraction service has drafted from this transcript.
  extracted  Boolean  @default(false)

  /// Who pulled this transcript out of Fireflies (R24, KTD14). Null on a pasted
  /// call, which is every call before the import path existed.
  ///
  /// Attribution rather than restriction is the control here, and it is the only
  /// one available: Biome records every call on one shared Fireflies account, so
  /// there is no per-person scope to enforce and any signed-in user can pull any
  /// recording. The relation is SetNull like every other user relation in this
  /// schema, which is why the address is kept beside it as a plain column — the
  /// same shape as Deal.ownerPm. Offboarding deletes the account; the record of
  /// who reached into the workspace has to outlive that.
  importedById    String?
  importedBy      User?   @relation("CallImporter", fields: [importedById], references: [id], onDelete: SetNull)
  importedByEmail String?
  /// The Fireflies meeting this transcript came from. Also what answers "is this
  /// meeting already on this deal" before anything is fetched (R25).
  ///
  /// Unique per deal rather than merely indexed. The service settles that
  /// question with a read, and a read cannot hold anything across the network
  /// fetch that follows it — so two PMs importing the same meeting onto the same
  /// deal at once would each be told it was absent and each write it. The
  /// call-number rule the same code leans on is a real constraint; this one had
  /// only the code in front of it. Postgres treats NULLs as distinct, so the many
  /// pasted calls on a deal are untouched, and the same meeting stays importable
  /// onto a *different* deal — both are the behaviour R25 asks for.
  sourceMeetingId String?

  /// When a run claimed this call for extraction (KTD17). Null when nothing
  /// holds it. The column lands in the block-run migration so the plan carries
  /// one migration, but the lease logic itself is U7's — nothing writes this yet.
  extractionClaimedAt DateTime?

  blockRuns ExtractionBlockRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealId, number])
  @@unique([dealId, sourceMeetingId])
  @@index([dealId])
  @@index([importedById])
}

/// What one extraction run did to one macro-dimension block of one call (KTD16).
///
/// This table, not `Call.extracted`, is the durable truth about a run: which
/// blocks were read, which failed and why, and what verification dropped —
/// legible after a refresh, which one boolean and a React state were not (R24).
/// One row per block per call: a re-run replaces the rows for the blocks it
/// attempted and leaves the others standing, mirroring the scoped observation
/// delete in lib/services/capture.ts. `Call.extracted` stays, derived, so
/// nothing that reads it breaks.
model ExtractionBlockRun {
  id     String @id @default(cuid())
  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  /// Which macro-dimension block this row describes, from /framework.
  rubricKey String
  /// A block that returned no usable output is never recorded read — the
  /// adapters throw on anything short of validated output (KTD5, R26), so the
  /// orchestrator only ever observes read or failed.
  outcome   ExtractionOutcome
  /// Why the block failed, in the words the run reported. Null on a read block.
  reason    String?

  /// Quotes this block returned that were not verbatim in the transcript.
  droppedQuotes Int @default(0)
  /// Claims from this block whose anchor quote did not survive verification.
  droppedClaims Int @default(0)
  /// Duplicate spans merged away. Stays 0 until the dedupe pass lands (U6).
  mergedSpans   Int @default(0)

  /// Which extraction-config version the run read with. Null until per-rubric
  /// config exists (U10).
  configVersion Int?
  ranAt         DateTime @default(now())

  @@unique([callId, rubricKey])
  @@index([callId])
}

/// A verbatim excerpt the machine drafted and the PM ruled on. Never a score.
model Observation {
  id              String            @id @default(cuid())
  dealId          String
  deal            Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  callNumber      Int
  rubricKey       String
  subDimensionKey String
  quote           String
  speaker         String?
  timestamp       String?
  status          ObservationStatus @default(draft)
  layer           Layer             @default(L1)

  /// How sure the machine was about the row it chose. Null on rows written
  /// before this existed, and on anything a human filed or re-mapped by hand.
  confidence MappingConfidence?
  /// One clause on why this row — "names a specific paying customer". Read while
  /// scoring, so a mis-filing is caught in place instead of in a separate pass.
  mappingNote String?

  /// Who accepted / edited / rejected it, and when.
  decidedById String?
  decidedBy   User?     @relation("ObservationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?

  anchoredClaims Claim[]
  citedBy        ScoreEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId, subDimensionKey])
  @@index([dealId, callNumber])
  @@index([decidedById])
}

/// The claim ledger. At L1 every entry opens "claimed" — nothing is verified yet.
model Claim {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  text   String

  originTag OriginTag
  status    ClaimStatus @default(claimed)

  /// The observation this claim is anchored to.
  anchorObsId String
  anchorObs   Observation @relation(fields: [anchorObsId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@index([anchorObsId])
}

/// One PM-authored sub-dimension score, unique per deal + sub-dimension + layer.
///
/// The value is stored as text alongside its scoreType rather than in two nullable
/// columns: it is a single union in the domain, and a CHECK constraint (added in
/// the migration) keeps the pair honest at the database level. lib/domain/codec.ts
/// is the only place that parses it.
model SubDimensionScore {
  id              String    @id @default(cuid())
  dealId          String
  deal            Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  subDimensionKey String
  scoreType       ScoreType
  /// "1".."5" | "NE" for scale rows; "pass" | "unv" | "fail" for binary rows.
  value           String
  /// e.g. a hygiene row that is flagged but not failed (advance-with-condition).
  flag            Boolean   @default(false)
  /// What the condition actually is, in one line.
  ///
  /// The flag was a bare boolean and that made it close to useless: "advance with
  /// condition" is not actionable at IC unless somebody can read which condition.
  /// Required by the service whenever flag is true.
  flagNote        String?
  layer           Layer     @default(L1)

  /// Which frozen rubric version this score was set against (spec D2).
  rubricVersion String @default("v1")

  authorId String?
  author   User?   @relation("ScoreAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  evidence ScoreEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealId, subDimensionKey, layer])
  @@index([dealId])
  @@index([authorId])
}

/// Which observations a score cites as evidence. No evidence => incomplete (D7, soft).
model ScoreEvidence {
  scoreId       String
  score         SubDimensionScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  observationId String
  observation   Observation       @relation(fields: [observationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([scoreId, observationId])
  @@index([observationId])
}

/// A PM's 0..10 read on a pillar or track. Never an average, never copied upward.
model Slide {
  id       String @id @default(cuid())
  dealId   String
  deal     Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  /// Pillar or track key from /framework.
  slideKey String

  /// Banked read, capped at the L1 ceiling while claims are unverified.
  value            Int
  /// Optional higher read, e.g. 8 "if the claim verifies". May exceed the cap.
  provisionalValue Int?
  lens             Lens
  /// Required one line naming which sub-dimension set the ceiling. The anti-vibe guard.
  ceilingGuard     String
  /// Whether a human signed off on that line, as opposed to leaving the machine's
  /// suggestion standing.
  ///
  /// The guard is prefilled now — the machine can find which rooted row is lowest
  /// under the lens, which is most of the typing. What it cannot know is whether
  /// that row is genuinely what holds the read down. So the text is offered and
  /// this flag records whether anybody agreed: an unconfirmed guard is a
  /// mechanical observation, a confirmed one is the PM's stated reason, and the
  /// scorecard is allowed to say which it is looking at.
  guardConfirmed   Boolean @default(false)
  layer            Layer  @default(L1)

  authorId String?
  author   User?   @relation("SlideAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealId, slideKey, layer])
  @@index([dealId])
  @@index([authorId])
}

/// The founder-type read. Context for the Founder/s track floor — not a verdict.
model FounderTypeRead {
  id     String @id @default(cuid())
  dealId String @unique
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  primary        String
  secondary      String?
  profile        String
  floorDimension String
  /// The PM's one-line confirmation or override.
  pmConfirmation String

  authorId String?
  author   User?   @relation("FounderReadAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

// ------------------------------------------------------------------ auth
// Auth.js v5 with the Prisma adapter. Sessions are JWT-strategy (required by the
// dev credentials provider), so the Session model is kept for adapter
// completeness and to leave a switch to database sessions open.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(PM)
  /// Only set for the dev-only credentials provider. Never used in production.
  passwordHash  String?

  accounts Account[]
  sessions Session[]

  ownedDeals           Deal[]              @relation("DealOwner")
  importedCalls        Call[]              @relation("CallImporter")
  authoredScores       SubDimensionScore[] @relation("ScoreAuthor")
  authoredSlides       Slide[]             @relation("SlideAuthor")
  authoredFounderReads FounderTypeRead[]   @relation("FounderReadAuthor")
  observationDecisions Observation[]       @relation("ObservationDecider")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
